# Copy to .env. Never commit .env or share logs with credentials.
CAMERA_HOST=192.168.1.10
CAMERA_PORT=554
CAMERA_USER=admin
# Keep quotes for passwords containing #, spaces or other special characters.
# Enter the raw password here; the application URL-encodes it automatically.
CAMERA_PASSWORD="CHANGE_ME"
CAMERA_CHANNEL=1
CAMERA_SUBTYPE=1

# Optional complete URL overrides camera fields. Encode URL credentials yourself.
# RTSP_URL="rtsp://admin:ENCODED_PASSWORD@192.168.1.10:554/cam/realmonitor?channel=1&subtype=1"
RTSP_TRANSPORT=tcp
OPEN_TIMEOUT_MS=3000
READ_TIMEOUT_MS=2000
RECONNECT_SECONDS=2
STALE_SECONDS=1
DISPLAY_WIDTH=960
METRICS_INTERVAL_SECONDS=1
# Optional. Default: data/logs under the project directory.
# LOG_DIR=D:/camera-logs
